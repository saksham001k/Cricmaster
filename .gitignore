# Environment and secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Data (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Trained models
models/*.pkl
models/*.joblib
models/*.pt
models/*.pth

# Generated datasets
*.parquet

# Never ignore gitkeep placeholders
!.gitkeep
models/**/*.joblib
models/**/metrics.json
